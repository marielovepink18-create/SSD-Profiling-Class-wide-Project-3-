; stage=pitfall label=buffered_aio_qd32 rep=2
; PITFALL: page cache serves reads of the 1 GiB range -> not the SSD
[global]
[pitfall__buffered_aio_qd32__r2]
filename=C\:\fio_test\ssd_profile_testfile.bin
ioengine=windowsaio
direct=0
rw=randread
bs=4k
iodepth=32
numjobs=1
size=1024m
offset=0
time_based=1
runtime=8
ramp_time=5
group_reporting=1
randrepeat=0
refill_buffers=1
buffer_compress_percentage=0
percentile_list=50:90:95:99:99.9:99.99
norandommap=1
