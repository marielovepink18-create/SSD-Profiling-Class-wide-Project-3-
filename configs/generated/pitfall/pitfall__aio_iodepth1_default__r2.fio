; stage=pitfall label=aio_iodepth1_default rep=2
; PITFALL: iodepth left at its default of 1 -> effective QD=1 (sync engines cannot use direct I/O on Windows)
[global]
[pitfall__aio_iodepth1_default__r2]
filename=C\:\fio_test\ssd_profile_testfile.bin
ioengine=windowsaio
direct=1
rw=randread
bs=4k
iodepth=1
numjobs=1
size=1024m
offset=0
time_based=1
runtime=8
ramp_time=1
group_reporting=1
randrepeat=0
refill_buffers=1
buffer_compress_percentage=0
percentile_list=50:90:95:99:99.9:99.99
norandommap=1
